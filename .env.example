# =====================================================
# Peg Solitaire Multiplayer — Environment Variables
# =====================================================
#
# ⚠️ Production (deploy จริง) ต้องใส่ค่าจริงของ Supabase ทั้ง 2 ตัวนี้
# มิเช่นนั้นผู้เล่นทุกคนจะอยู่ใน Local Mode (เล่นได้แค่เครื่องตัวเอง)
#
# 🧪 ตอน dev ทดสอบบน localhost ไม่ต้องใส่ก็ได้
#    แอปจะ auto-detect ว่าค่าว่าง/placeholder → ใช้ Local Mode
#

# ค่าจาก Supabase Dashboard → Settings → API
# ตัวอย่าง: https://abcd1234efgh.supabase.co
VITE_SUPABASE_URL=

# anon public key (ไม่ใช่ service_role key!)
# ตัวอย่าง: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIs...
VITE_SUPABASE_ANON_KEY=